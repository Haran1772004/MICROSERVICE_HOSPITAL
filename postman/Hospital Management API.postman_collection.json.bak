{
  "info": {
    "_postman_id": "7c90b419-1b40-4e85-b0dd-6c61d98a63d0",
    "name": "Hospital Management API",
    "description": "Postman collection for the three Spring Boot services. Ports: auth 8081, hospital 8082, appointments 8083.\n\nStart the databases and all three services first. The compose file starts databases only. Seed auth-service's admin/receptionist accounts with auth-service/src/main/resources/db/seed_admin_receptionist.sql, or provide your own credentials in collection variables.\n\nSuggested flow: 1) Admin login. 2) Create an active department (or set departmentId to an existing active department). 3) Register a patient and doctor. 4) Login as admin, list pending doctors and approve one. 5) Login as the patient and doctor, fetch /patients/me to capture patientId, and use the available-slots endpoint before booking. 6) Create a medical record for a scheduled appointment, then create a prescription for that record.\n\nCollection variables provide local URLs, sample credentials, IDs, and a development appointment date/time. Change sample usernames/emails before re-running registration requests; they must be unique. Internal requests require internalApiSecret to match the services' INTERNAL_API_SECRET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const tomorrow = new Date(Date.now() + 86400000).toISOString().slice(0, 10);",
          "pm.collectionVariables.set('tomorrow', tomorrow);"
        ]
      }
    }
  ],
  "variable": [
    { "key": "authUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "hospitalUrl", "value": "http://localhost:8082", "type": "string" },
    { "key": "appointmentUrl", "value": "http://localhost:8083", "type": "string" },
    { "key": "adminUsername", "value": "admin", "type": "string" },
    { "key": "adminPassword", "value": "Admin@123", "type": "string" },
    { "key": "receptionistUsername", "value": "receptionist", "type": "string" },
    { "key": "receptionistPassword", "value": "Reception@123", "type": "string" },
    { "key": "patientUsername", "value": "patient_demo", "type": "string" },
    { "key": "patientPassword", "value": "Patient@123", "type": "string" },
    { "key": "patientName", "value": "Demo Patient", "type": "string" },
    { "key": "patientPhone", "value": "+15551234567", "type": "string" },
    { "key": "patientEmail", "value": "patient_demo@example.com", "type": "string" },
    { "key": "doctorUsername", "value": "doctor_demo", "type": "string" },
    { "key": "doctorPassword", "value": "Doctor@123", "type": "string" },
    { "key": "doctorName", "value": "Dr. Demo", "type": "string" },
    { "key": "doctorPhone", "value": "+15557654321", "type": "string" },
    { "key": "doctorEmail", "value": "doctor_demo@example.com", "type": "string" },
    { "key": "rejectDoctorId", "value": "999999", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "receptionistToken", "value": "", "type": "string" },
    { "key": "patientToken", "value": "", "type": "string" },
    { "key": "doctorToken", "value": "", "type": "string" },
    { "key": "departmentId", "value": "1", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "patientId", "value": "1", "type": "string" },
    { "key": "doctorId", "value": "1", "type": "string" },
    { "key": "appointmentId", "value": "1", "type": "string" },
    { "key": "recordId", "value": "1", "type": "string" },
    { "key": "addressId", "value": "1", "type": "string" },
    { "key": "tomorrow", "value": "", "type": "string" },
    { "key": "appointmentTime", "value": "09:00:00", "type": "string" },
    { "key": "internalApiSecret", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Bootstrap and registrations",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{authUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeds', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.collectionVariables.set('adminToken', body.token);", "pm.collectionVariables.set('authToken', body.token);"] } }]
        },
        {
          "name": "Create department",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cardiology\",\n  \"description\": \"Heart and cardiovascular care\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{hospitalUrl}}/departments"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Department created', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "if (body.departmentId) pm.collectionVariables.set('departmentId', String(body.departmentId));"] } }]
        },
        {
          "name": "Register patient",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{patientUsername}}\",\n  \"password\": \"{{patientPassword}}\",\n  \"name\": \"{{patientName}}\",\n  \"dob\": \"1990-04-20\",\n  \"gender\": \"OTHER\",\n  \"phone\": \"{{patientPhone}}\",\n  \"email\": \"{{patientEmail}}\",\n  \"state\": \"California\",\n  \"district\": \"Los Angeles\",\n  \"pincode\": \"90001\",\n  \"addressType\": \"HOME\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{authUrl}}/auth/register/patient"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Patient registration returns 201', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "Register doctor (pending approval)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{doctorUsername}}\",\n  \"password\": \"{{doctorPassword}}\",\n  \"name\": \"{{doctorName}}\",\n  \"specialization\": \"Cardiology\",\n  \"phone\": \"{{doctorPhone}}\",\n  \"email\": \"{{doctorEmail}}\",\n  \"departmentId\": {{departmentId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{authUrl}}/auth/register/doctor"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Doctor registration returns 201', () => pm.response.to.have.status(201));"] } }]
        }
      ]
    },
    {
      "name": "02 - Doctor approval (admin)",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
      "item": [
        {
          "name": "List pending doctors",
          "request": { "method": "GET", "url": "{{hospitalUrl}}/admin/doctors/pending" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Pending doctors returned', () => pm.response.to.have.status(200));", "const doctors = pm.response.json();", "const doctor = doctors.find(item => item.email === pm.collectionVariables.get('doctorEmail'));", "if (doctor) pm.collectionVariables.set('doctorId', String(doctor.doctorId));"] } }]
        },
        {
          "name": "Approve registered doctor",
          "request": { "method": "POST", "url": "{{hospitalUrl}}/admin/doctors/{{doctorId}}/approve" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Doctor approval succeeds', () => pm.response.to.have.status(200));"] } }]
        },
        { "name": "Reject a different pending doctor (optional)", "request": { "method": "POST", "url": "{{hospitalUrl}}/admin/doctors/{{rejectDoctorId}}/reject" } }
      ]
    },
    {
      "name": "03 - Role logins and profile checks",
      "item": [
        {
          "name": "Receptionist login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{receptionistUsername}}\",\n  \"password\": \"{{receptionistPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{authUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Receptionist login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('receptionistToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Patient login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{patientUsername}}\",\n  \"password\": \"{{patientPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{authUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Patient login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('patientToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Doctor login (run after approval)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{doctorUsername}}\",\n  \"password\": \"{{doctorPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{authUrl}}/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Approved doctor can log in', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('doctorToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Get my patient profile (saves patientId)",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "method": "GET", "url": "{{hospitalUrl}}/patients/me" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Patient profile exists and is active', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.collectionVariables.set('patientId', String(body.patientId));", "pm.test('Patient status is ACTIVE', () => pm.expect(body.status).to.eql('ACTIVE'));"] } }]
        },
        {
          "name": "Get my patient addresses",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] }, "method": "GET", "url": "{{hospitalUrl}}/patient-addresses/me" }
        },
        {
          "name": "Get approved doctor profile",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "GET", "url": "{{hospitalUrl}}/doctors/{{doctorId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Doctor profile is active', () => pm.response.to.have.status(200));", "pm.test('Doctor status is ACTIVE', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));"] } }]
        },
        { "name": "Get doctor auth account", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "GET", "url": "{{authUrl}}/users/{{doctorUsername}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Doctor auth account is active', () => pm.response.to.have.status(200));", "pm.test('Auth account status is ACTIVE', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));"] } }]
        }
      ]
    },
    {
      "name": "04 - Admin APIs",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
      "item": [
        { "name": "List users", "request": { "method": "GET", "url": "{{authUrl}}/users" } },
        { "name": "Get user by username", "request": { "method": "GET", "url": "{{authUrl}}/users/{{patientUsername}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User found', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.collectionVariables.set('userId', String(body.userId));"] } }]
        },
        { "name": "List pending users by role", "request": { "method": "GET", "url": "{{authUrl}}/users/pending/DOCTOR" } },
        { "name": "Create receptionist user", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"reception_two\",\n  \"password\": \"Reception@456\",\n  \"role\": \"RECEPTIONIST\",\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{authUrl}}/users" } },
        { "name": "Change user status", "request": { "method": "PUT", "url": "{{authUrl}}/users/{{receptionistUsername}}/status?status=ACTIVE" } },
        { "name": "Deactivate user by ID", "request": { "method": "PATCH", "url": "{{authUrl}}/admin/users/{{userId}}/deactivate" } },
        { "name": "List departments", "request": { "method": "GET", "url": "{{hospitalUrl}}/departments" } },
        { "name": "Get department by ID", "request": { "method": "GET", "url": "{{hospitalUrl}}/departments/{{departmentId}}" } },
        { "name": "Update department", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cardiology\",\n  \"description\": \"Updated department description\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/departments/{{departmentId}}" } },
        { "name": "Deactivate department", "request": { "method": "PATCH", "url": "{{hospitalUrl}}/departments/{{departmentId}}/deactivate" } },
        { "name": "Activate department", "request": { "method": "PATCH", "url": "{{hospitalUrl}}/departments/{{departmentId}}/activate" } },
        { "name": "List doctors", "request": { "method": "GET", "url": "{{hospitalUrl}}/doctors" } },
        { "name": "Create doctor profile without login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Dr. No Login\",\n  \"specialization\": \"Neurology\",\n  \"phone\": \"+15550000001\",\n  \"email\": \"doctor.no.login@example.com\",\n  \"departmentId\": {{departmentId}}\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/doctors" } },
        { "name": "Update doctor profile", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{doctorName}}\",\n  \"specialization\": \"Cardiology\",\n  \"phone\": \"{{doctorPhone}}\",\n  \"email\": \"{{doctorEmail}}\",\n  \"departmentId\": {{departmentId}}\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/doctors/{{doctorId}}" } },
        { "name": "Deactivate doctor", "request": { "method": "PATCH", "url": "{{hospitalUrl}}/doctors/{{doctorId}}/deactivate" } },
        { "name": "Activate doctor", "request": { "method": "PATCH", "url": "{{hospitalUrl}}/doctors/{{doctorId}}/activate" } },
        { "name": "List all patients", "request": { "method": "GET", "url": "{{hospitalUrl}}/patients" } },
        { "name": "Get patient by ID", "request": { "method": "GET", "url": "{{hospitalUrl}}/patients/{{patientId}}" } },
        { "name": "List patients by status", "request": { "method": "GET", "url": "{{hospitalUrl}}/patients/status/ACTIVE" } },
        { "name": "Create patient without login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Walk-in Patient\",\n  \"dob\": \"1985-02-10\",\n  \"gender\": \"FEMALE\",\n  \"phone\": \"+15550000002\",\n  \"email\": \"walkin.patient@example.com\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patients" } },
        { "name": "Update patient by ID", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{patientName}}\",\n  \"dob\": \"1990-04-20\",\n  \"gender\": \"OTHER\",\n  \"phone\": \"{{patientPhone}}\",\n  \"email\": \"{{patientEmail}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patients/{{patientId}}" } },
        { "name": "Deactivate patient", "request": { "method": "PATCH", "url": "{{hospitalUrl}}/patients/{{patientId}}/deactivate" } },
        { "name": "Activate patient", "request": { "method": "PATCH", "url": "{{hospitalUrl}}/patients/{{patientId}}/activate" } },
        { "name": "List all patient addresses", "request": { "method": "GET", "url": "{{hospitalUrl}}/patient-addresses" } },
        { "name": "List addresses for patient", "request": { "method": "GET", "url": "{{hospitalUrl}}/patient-addresses/patient/{{patientId}}" } },
        { "name": "Get patient's default address", "request": { "method": "GET", "url": "{{hospitalUrl}}/patient-addresses/patient/{{patientId}}/default" } },
        { "name": "Get address by ID", "request": { "method": "GET", "url": "{{hospitalUrl}}/patient-addresses/{{addressId}}" } },
        { "name": "Create address for patient", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"patientId\": {{patientId}},\n  \"state\": \"California\",\n  \"district\": \"San Diego\",\n  \"pincode\": \"92101\",\n  \"addressType\": \"WORK\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patient-addresses" } },
        { "name": "Update address", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"patientId\": {{patientId}},\n  \"state\": \"California\",\n  \"district\": \"Los Angeles\",\n  \"pincode\": \"90001\",\n  \"addressType\": \"HOME\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patient-addresses/{{addressId}}" } },
        { "name": "Delete address", "request": { "method": "DELETE", "url": "{{hospitalUrl}}/patient-addresses/{{addressId}}" } }
      ]
    },
    {
      "name": "05 - Receptionist APIs",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{receptionistToken}}", "type": "string" }] },
      "item": [
        { "name": "Get all patients", "request": { "method": "GET", "url": "{{hospitalUrl}}/patients" } },
        { "name": "Get patient by ID", "request": { "method": "GET", "url": "{{hospitalUrl}}/patients/{{patientId}}" } },
        { "name": "Create patient without login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Reception Patient\",\n  \"dob\": \"1988-06-15\",\n  \"gender\": \"MALE\",\n  \"phone\": \"+15550000003\",\n  \"email\": \"reception.patient@example.com\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patients" } },
        { "name": "Add address for patient", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"patientId\": {{patientId}},\n  \"state\": \"California\",\n  \"district\": \"Los Angeles\",\n  \"pincode\": \"90001\",\n  \"addressType\": \"HOME\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patient-addresses" } },
        { "name": "Create appointment for patient", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"patientId\": {{patientId}},\n  \"doctorId\": {{doctorId}},\n  \"appointmentDate\": \"{{tomorrow}}\",\n  \"appointmentTime\": \"{{appointmentTime}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{appointmentUrl}}/appointments" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Appointment created', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.collectionVariables.set('appointmentId', String(body.appointmentId));"] } }]
        }
      ]
    },
    {
      "name": "06 - Patient APIs",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
      "item": [
        { "name": "Get own profile", "request": { "method": "GET", "url": "{{hospitalUrl}}/patients/me" } },
        { "name": "Update own profile", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{patientName}}\",\n  \"dob\": \"1990-04-20\",\n  \"gender\": \"OTHER\",\n  \"phone\": \"{{patientPhone}}\",\n  \"email\": \"{{patientEmail}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patients/me" } },
        { "name": "Get own addresses", "request": { "method": "GET", "url": "{{hospitalUrl}}/patient-addresses/me" } },
        { "name": "Get own default address", "request": { "method": "GET", "url": "{{hospitalUrl}}/patient-addresses/me/default" } },
        { "name": "Add address to own profile", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"state\": \"California\",\n  \"district\": \"Los Angeles\",\n  \"pincode\": \"90001\",\n  \"addressType\": \"HOME\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patient-addresses/me" },
        { "name": "Add address (patient route)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"state\": \"California\",\n  \"district\": \"Los Angeles\",\n  \"pincode\": \"90001\",\n  \"addressType\": \"WORK\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patient-addresses" },
        { "name": "Get own addresses by patient ID", "request": { "method": "GET", "url": "{{hospitalUrl}}/patient-addresses/patient/{{patientId}}" } },
        { "name": "Get own default address by patient ID", "request": { "method": "GET", "url": "{{hospitalUrl}}/patient-addresses/patient/{{patientId}}/default" } },
        { "name": "Update own address", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"state\": \"California\",\n  \"district\": \"Los Angeles\",\n  \"pincode\": \"90001\",\n  \"addressType\": \"HOME\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/patient-addresses/{{addressId}}" } },
        { "name": "Delete own address", "request": { "method": "DELETE", "url": "{{hospitalUrl}}/patient-addresses/{{addressId}}" } },
        { "name": "Get doctor available slots", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/doctor/{{doctorId}}/available?date={{tomorrow}}" } },
        { "name": "Book appointment (patient; omit patientId)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"doctorId\": {{doctorId}},\n  \"appointmentDate\": \"{{tomorrow}}\",\n  \"appointmentTime\": \"{{appointmentTime}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{appointmentUrl}}/appointments" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Patient appointment is scheduled', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.collectionVariables.set('appointmentId', String(body.appointmentId));", "pm.test('Response has expected patient and doctor IDs', () => { pm.expect(String(body.patientId)).to.eql(pm.collectionVariables.get('patientId')); pm.expect(String(body.doctorId)).to.eql(pm.collectionVariables.get('doctorId')); });", "pm.test('Appointment status is SCHEDULED', () => pm.expect(body.status).to.eql('SCHEDULED'));"] } }]
        },
        { "name": "List appointments", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments" } },
        { "name": "List appointments for today", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/today" } },
        { "name": "Get appointment by ID", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/{{appointmentId}}" } },
        { "name": "List appointments by patient", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/patient/{{patientId}}" } },
        { "name": "List appointments by doctor", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/doctor/{{doctorId}}" } },
        { "name": "List doctor appointments on date", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/doctor/{{doctorId}}/today?date={{tomorrow}}" } },
        { "name": "Cancel appointment", "request": { "method": "PATCH", "url": "{{appointmentUrl}}/appointments/{{appointmentId}}/cancel" } },
        { "name": "List medical records", "request": { "method": "GET", "url": "{{appointmentUrl}}/medical-records" } },
        { "name": "Get medical record by ID", "request": { "method": "GET", "url": "{{appointmentUrl}}/medical-records/{{recordId}}" } },
        { "name": "Get medical record by appointment", "request": { "method": "GET", "url": "{{appointmentUrl}}/medical-records/appointment/{{appointmentId}}" } },
        { "name": "List medical records by patient", "request": { "method": "GET", "url": "{{appointmentUrl}}/medical-records/patient/{{patientId}}" } },
        { "name": "List prescriptions for record", "request": { "method": "GET", "url": "{{appointmentUrl}}/prescriptions/record/{{recordId}}" } }
      ]
    },
    {
      "name": "07 - Doctor APIs",
      "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
      "item": [
        { "name": "List departments", "request": { "method": "GET", "url": "{{hospitalUrl}}/departments" } },
        { "name": "List doctors", "request": { "method": "GET", "url": "{{hospitalUrl}}/doctors" } },
        { "name": "Get own doctor profile", "request": { "method": "GET", "url": "{{hospitalUrl}}/doctors/{{doctorId}}" } },
        { "name": "List appointments", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments" } },
        { "name": "List today's appointments", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/today" } },
        { "name": "Get appointment by ID", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/{{appointmentId}}" } },
        { "name": "List doctor's appointments", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/doctor/{{doctorId}}" } },
        { "name": "List doctor appointments on date", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/doctor/{{doctorId}}/today?date={{tomorrow}}" } },
        { "name": "Check available slots", "request": { "method": "GET", "url": "{{appointmentUrl}}/appointments/doctor/{{doctorId}}/available?date={{tomorrow}}" } },
        { "name": "Create medical record for scheduled appointment", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"appointmentId\": {{appointmentId}},\n  \"diagnosis\": \"Routine consultation\",\n  \"treatmentNotes\": \"Follow the prescribed care plan.\",\n  \"recordDate\": \"{{tomorrow}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{appointmentUrl}}/medical-records" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Medical record created', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.collectionVariables.set('recordId', String(body.recordId));"] } }]
        },
        { "name": "List medical records", "request": { "method": "GET", "url": "{{appointmentUrl}}/medical-records" } },
        { "name": "Get medical record by ID", "request": { "method": "GET", "url": "{{appointmentUrl}}/medical-records/{{recordId}}" } },
        { "name": "Get medical record by appointment", "request": { "method": "GET", "url": "{{appointmentUrl}}/medical-records/appointment/{{appointmentId}}" } },
        { "name": "List medical records by patient", "request": { "method": "GET", "url": "{{appointmentUrl}}/medical-records/patient/{{patientId}}" } },
        { "name": "List medical records by doctor", "request": { "method": "GET", "url": "{{appointmentUrl}}/medical-records/doctor/{{doctorId}}" } },
        { "name": "Create prescription", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"recordId\": {{recordId}},\n  \"medicineName\": \"Example medicine\",\n  \"dosage\": \"1 tablet twice daily\",\n  \"duration\": \"5 days\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{appointmentUrl}}/prescriptions" } },
        { "name": "List prescriptions for record", "request": { "method": "GET", "url": "{{appointmentUrl}}/prescriptions/record/{{recordId}}" } }
      ]
    },
    {
      "name": "08 - Internal service endpoints (requires shared secret)",
      "item": [
        { "name": "Create patient profile internally", "request": { "method": "POST", "header": [{ "key": "X-Internal-Secret", "value": "{{internalApiSecret}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": 999,\n  \"name\": \"Internal Patient\",\n  \"dob\": \"1990-01-01\",\n  \"gender\": \"OTHER\",\n  \"phone\": \"+15550000004\",\n  \"email\": \"internal.patient@example.com\",\n  \"state\": \"California\",\n  \"district\": \"Los Angeles\",\n  \"pincode\": \"90001\",\n  \"addressType\": \"HOME\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/internal/patients" } },
        { "name": "Create doctor profile internally", "request": { "method": "POST", "header": [{ "key": "X-Internal-Secret", "value": "{{internalApiSecret}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": 999,\n  \"name\": \"Internal Doctor\",\n  \"specialization\": \"Neurology\",\n  \"phone\": \"+15550000005\",\n  \"email\": \"internal.doctor@example.com\",\n  \"departmentId\": {{departmentId}}\n}", "options": { "raw": { "language": "json" } } }, "url": "{{hospitalUrl}}/internal/doctors" } },
        { "name": "Get internal patient by ID", "request": { "method": "GET", "header": [{ "key": "X-Internal-Secret", "value": "{{internalApiSecret}}" }], "url": "{{hospitalUrl}}/internal/patients/{{patientId}}" } },
        { "name": "Get internal patient by auth user ID", "request": { "method": "GET", "header": [{ "key": "X-Internal-Secret", "value": "{{internalApiSecret}}" }], "url": "{{hospitalUrl}}/internal/patients/by-user/{{userId}}" } },
        { "name": "Get internal doctor by ID", "request": { "method": "GET", "header": [{ "key": "X-Internal-Secret", "value": "{{internalApiSecret}}" }], "url": "{{hospitalUrl}}/internal/doctors/{{doctorId}}" } },
        { "name": "Delete internal profile by user ID (destructive)", "request": { "method": "DELETE", "header": [{ "key": "X-Internal-Secret", "value": "{{internalApiSecret}}" }], "url": "{{hospitalUrl}}/internal/profiles/by-user/{{userId}}" } },
        { "name": "Update auth user status internally", "request": { "method": "PATCH", "header": [{ "key": "X-Internal-Secret", "value": "{{internalApiSecret}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{authUrl}}/internal/users/{{userId}}/status" } },
        { "name": "Delete auth user internally (destructive)", "request": { "method": "DELETE", "header": [{ "key": "X-Internal-Secret", "value": "{{internalApiSecret}}" }], "url": "{{authUrl}}/internal/users/{{userId}}" } }
      ]
    }
  ]
}
